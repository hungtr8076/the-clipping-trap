-            decoded_image = torch.clamp(decoded_image, 0.0, 1.0)
+            # Output mapping g used in the loss (The Clipping Trap). The derivative of
+            # torch.clamp is zero outside [0, 1], and this clamp lies inside the function
+            # that the per-image optimization differentiates. With no variable set, the
+            # shipped clamp is used.
+            if os.environ.get("CC_STRAIGHT_THROUGH_CLAMP") == "1" and self.training:
+                # Forward value of the clamp, gradient of the identity.
+                clamped = torch.clamp(decoded_image, 0.0, 1.0)
+                decoded_image = decoded_image + (clamped - decoded_image).detach()
+            elif os.environ.get("CC_NO_CLAMP_TRAIN") == "1" and self.training:
+                # No clamp during the optimization; the clamp is still applied at
+                # inference (self.training is False there).
+                pass
+            elif os.environ.get("CC_LEAKY_CLAMP") == "1" and self.training:
+                # Identity inside [0, 1], slope a outside.
+                a = float(os.environ.get("CC_LEAKY_SLOPE", "0.01"))
+                decoded_image = torch.where(
+                    decoded_image > 1.0, 1.0 + a * (decoded_image - 1.0),
+                    torch.where(decoded_image < 0.0, a * decoded_image, decoded_image))
+            elif os.environ.get("CC_SIGMOID_OUT") == "1":
+                # sigmoid(4 (y - 0.5)), slope 1 at y = 0.5, applied at training and at
+                # inference; bitstream/decode.py applies it under the same variable.
+                decoded_image = torch.sigmoid(4.0 * (decoded_image - 0.5))
+            else:
+                decoded_image = torch.clamp(decoded_image, 0.0, 1.0)
 
         # Quantization
